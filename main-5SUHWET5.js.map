{
  "name": "hey-bible",
  "version": "1.12.1",
  "author": "bobby@workingdevshero.com",
  "homepage": "https://heybible.app",
  "database": "hey-bible",
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"npx supabase start && npm run start:functions\" \"ng serve --configuration local\" \"wait-on http://localhost:4200 && open http://localhost:4200\"",
    "start:prod": "ng serve --configuration production",
    "start:ios": "ionic capacitor build ios --source-map",
    "poststart:ios": "npm run sourcemaps",
    "start:ios-local": "ng build --configuration ios-local && npx cap sync ios && npx cap open ios",
    "serve:lan": "ng serve --host 0.0.0.0 --configuration ios-local",
    "start:android": "ionic capacitor build android --source-map",
    "poststart:android": "npm run sourcemaps",
    "start:functions": "npx supabase functions serve",
    "debug:functions": "npx supabase functions serve --inspect-mode brk",
    "email:local": "open \"http://localhost:54324/\"",
    "studio:local": "open \"http://localhost:54323/\"",
    "build:prod": "ng build --configuration production",
    "postbuild:prod": "npm run sourcemaps",
    "db:reset": "npx supabase db reset",
    "db:push": "npx supabase db push",
    "db:pull": "npx supabase db pull",
    "db:seed": "ts-node supabase/data/create.ts",
    "db:stop": "npx supabase stop",
    "db:types": "npx supabase gen types typescript --local > supabase/types/supabase.ts && cp supabase/types/supabase.ts supabase/functions/_shared/supabase.ts",
    "sourcemaps": "node -r dotenv/config $(which npx) @bugsplat/symbol-upload -d ./www/browser",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "lint": "export NODE_OPTIONS='--max-old-space-size=16384' && ng lint  --fix --cache"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.9",
    "@angular/cdk": "^20.2.11",
    "@angular/common": "^20.3.9",
    "@angular/compiler": "^20.3.9",
    "@angular/core": "^20.3.9",
    "@angular/forms": "^20.3.9",
    "@angular/platform-browser": "^20.3.9",
    "@angular/platform-browser-dynamic": "^20.3.9",
    "@angular/router": "^20.3.9",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.2",
    "@capacitor/browser": "^7.0.3",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/clipboard": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/keyboard": "^7.0.2",
    "@capacitor/screen-orientation": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2",
    "@capgo/capacitor-social-login": "^7.11.0",
    "@hey-bible/bible-reference-parser": "^4.0.0",
    "@ionic/angular": "^8.7.3",
    "@ionic/pwa-elements": "^3.3.0",
    "@ionic/storage-angular": "^4.0.0",
    "@ngneat/error-tailor": "^5.0.1",
    "@supabase/supabase-js": "^2.56.0",
    "bugsplat-ng": "^18.0.1",
    "ionicons": "^8.0.13",
    "marked": "^15.0.12",
    "ngx-markdown": "^20.0.0",
    "openmoji": "^16.0.0",
    "rxjs": "~7.8.2",
    "title-case": "^4.3.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.8",
    "@angular-eslint/builder": "^20.5.0",
    "@angular-eslint/eslint-plugin": "^20.5.0",
    "@angular-eslint/eslint-plugin-template": "^20.5.0",
    "@angular-eslint/schematics": "^20.5.0",
    "@angular-eslint/template-parser": "^20.5.0",
    "@angular/build": "^20.3.8",
    "@angular/cli": "^20.3.8",
    "@angular/compiler-cli": "^20.3.9",
    "@angular/language-service": "^20.3.9",
    "@bugsplat/symbol-upload": "^10.1.11",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.3",
    "@ionic/angular-toolkit": "^12.3.0",
    "@types/jasmine": "~5.1.9",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@typescript-eslint/types": "^8.46.2",
    "@typescript-eslint/utils": "^8.46.2",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.1",
    "eslint": "^9.34.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^54.1.1",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "jasmine-auto-spies": "^8.0.1",
    "jasmine-core": "~5.9.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-mocks": "^14.14.0",
    "supabase": "^2.76.8",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3"
  },
  "description": "Your friendly Bible companion"
}
